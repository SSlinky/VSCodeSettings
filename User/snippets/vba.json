	"Unit Test Template": {
		"prefix": "test",
		"description": "Unit test basic template",
		"body": [
			"Private Function Test${1:Class}_${2:Identifier}() As TestResult",
			"Attribute Test$1_$2.VB_Description = \"${3:Dosctring}.\"",
			"'   $3.",
			"    Dim tr As New TestResult",
			"",
			"'   Arrange",
			"    $0",
			"",
			"'   Act",
			"",
			"",
			"'   Assert",
			"",
			"",
			"Finally:",
			"    Set Test$1_$2 = tr",
			"End Function"
		]
	}
}